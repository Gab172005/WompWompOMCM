# Optional API base; omit /api and the trailing slash.
VITE_API_URL=
# true = browser-only demo; false = try API, then visibly fall back on initial failure.
VITE_DEMO_MODE=false
# Development proxy target; not a client-exposed variable.
OMCM_PROXY_TARGET=http://127.0.0.1:8000

# Optional Firebase web configuration, reserved for a future integration.
# Setting these values does not connect Firebase or change schedule storage.
# Use web app configuration only; never place service-account secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_URL=

# Optional Google Maps SDK preparation; Leaflet remains the active renderer.
# This is a browser-visible key. Restrict it to your website HTTP referrers
# and Maps JavaScript API. Never put the private Routes API key here.
VITE_GOOGLE_MAPS_API_KEY=
