# Frontend configuration: copy to frontend/.env only when overrides are needed.
# Leave empty locally to use Vite's /api proxy. Hosted builds need the API origin.
VITE_API_URL=
# Connected backend authentication and schedules.
VITE_DEMO_MODE=false
# Development proxy only; not delivered to the browser.
OMCM_PROXY_TARGET=http://127.0.0.1:8000

# Optional browser-visible Google Maps key; restrict by referrer and API.
# Never put a private Routes key, database URL, or admin password here.
VITE_GOOGLE_MAPS_API_KEY=
