{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "vitest": [
        "./node_modules/vitest"
      ],
      "@testing-library/*": [
        "./node_modules/@testing-library/*"
      ],
      "geojson": [
        "./node_modules/@types/geojson"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../tests/frontend/**/*.ts",
    "../tests/frontend/**/*.tsx"
  ]
}
