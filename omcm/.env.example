# Backend configuration: copy to backend/.env and keep real values out of Git.
OMCM_DATASET=pilot
OMCM_DEMO_AUTH=true
OMCM_ADMIN_USERNAME=
OMCM_ADMIN_PASSWORD=
OMCM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Override the project-specific preview allowlist when hosting elsewhere.
# OMCM_CORS_ORIGIN_REGEX=your-anchored-preview-origin-pattern

# Local SQLite. A configured DATABASE_URL selects PostgreSQL instead.
OMCM_DATABASE_PATH=omcm.db
# Server-only pooled PostgreSQL URL; existing SQLite rows are not copied.
DATABASE_URL=

# Optional Gemini assistant. Without a key, supported local commands still work.
OMCM_CHAT_API_KEY=
OMCM_CHAT_MODEL=
# Retained explanation and chat adapters.
OMCM_EXPLANATION_PROVIDER=deterministic
OMCM_CHAT_PROVIDER=template
OMCM_CHAT_URL=

# Optional Google Routes pilot adapter; not the provincial planner's road matrix.
OMCM_GOOGLE_ROUTES_ENABLED=false
OMCM_GOOGLE_ROUTES_API_KEY=
# Offline road import only; use an appropriate OSRM service for bulk requests.
# OMCM_OSRM_URL=https://your-osrm-service.example
