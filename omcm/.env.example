# Copy to backend/.env; enter your own local demo credentials.
OMCM_DEMO_AUTH=true
OMCM_ADMIN_USERNAME=
OMCM_ADMIN_PASSWORD=
OMCM_DATABASE_PATH=omcm.db
OMCM_DATASET=pilot
OMCM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Frontend: copy this line to frontend/.env only for a separately hosted API.
# VITE_API_URL=https://your-backend.onrender.com
# VITE_DEMO_MODE=true
# Set VITE_DEMO_MODE=true for an explicitly browser-only rehearsal. With false
# or unset, an unavailable health endpoint activates a visibly labeled fallback.
# Development proxy only (not exposed in the browser):
# OMCM_PROXY_TARGET=http://127.0.0.1:8000
# Offline import script only; use your own OSRM service for repeated/bulk imports:
# OMCM_OSRM_URL=https://routing.openstreetmap.de/routed-car
# No Google or other secret map key is needed: Leaflet/OSM is the existing provider.
