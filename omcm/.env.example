# Copy to backend/.env; enter your own local demo credentials.
OMCM_DEMO_AUTH=true
OMCM_ADMIN_USERNAME=
OMCM_ADMIN_PASSWORD=
OMCM_DATABASE_PATH=omcm.db
OMCM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Frontend: copy this line to frontend/.env only for a separately hosted API.
# VITE_API_URL=https://your-backend.onrender.com
